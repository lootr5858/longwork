{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/skills/longwork/guard.sh\" mark codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/skills/longwork/guard.sh\" check codex"
          }
        ]
      }
    ]
  }
}
